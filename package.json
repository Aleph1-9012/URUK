{
  "name": "uruk",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc -p scripts --noEmit && tsc -p tests --noEmit",
    "check:content": "bun scripts/check-content.ts",
    "test": "bun test",
    "check:screens": "bun scripts/check-screens.ts",
    "check:interactions": "bun scripts/check-interactions.ts",
    "verify": "bun run check && bun run check:content && bun test && bun run build"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@types/bun": "1.4.3",
    "@types/mdast": "4.0.4",
    "astro": "7.4.1",
    "hast-util-to-html": "9.0.6",
    "mdast-util-to-hast": "13.2.1",
    "playwright-core": "1.64.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "temml": "0.14.0",
    "typescript": "6.0.3",
    "unified": "11.0.5"
  }
}
