---
import clearUrl from '../../assets/icons/clear.svg?url';
import closeUrl from '../../assets/icons/close.svg?url';
import downUrl from '../../assets/icons/down.svg?url';
import leftUrl from '../../assets/icons/left.svg?url';
import openUrl from '../../assets/icons/open.svg?url';
import rightUrl from '../../assets/icons/right.svg?url';
import rollBackUrl from '../../assets/icons/roll-back.svg?url';
import rollForwardUrl from '../../assets/icons/roll-forward.svg?url';
import searchUrl from '../../assets/icons/search.svg?url';

interface Props {
  name:
    | 'right'
    | 'left'
    | 'down'
    | 'roll-forward'
    | 'roll-back'
    | 'open'
    | 'close'
    | 'search'
    | 'clear';
}

const { name } = Astro.props;
// The cut paths are thousands of points each, so a page points at the file instead of carrying a copy per use.
const icons = {
  right: rightUrl,
  left: leftUrl,
  down: downUrl,
  'roll-forward': rollForwardUrl,
  'roll-back': rollBackUrl,
  open: openUrl,
  close: closeUrl,
  search: searchUrl,
  clear: clearUrl,
} as const;
---

<svg
  aria-hidden="true"
  preserveAspectRatio="none"
  overflow="visible"
  style="display: block;"
  width="12"
  height="12"
  viewBox="0 0 12 12"
  fill="none"
>
  <use href={`${icons[name]}#icon`}></use>
</svg>
