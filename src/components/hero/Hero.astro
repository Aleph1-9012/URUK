---
import Icon from '../icon/Icon.astro';
import plateLarge from '../../assets/hero/engraving.webp?url';
import plateSmall from '../../assets/hero/engraving-760.webp?url';
import desktopTextureOneX from '../../assets/hero/texture-desktop-1440.webp?url';
import desktopTextureTwoX from '../../assets/hero/texture-desktop-2880.webp?url';
import phoneTextureOneX from '../../assets/hero/texture-phone-390.webp?url';
import phoneTextureTwoX from '../../assets/hero/texture-phone-780.webp?url';
import logoUrl from '../../assets/logo/uruk.svg?url';
import SupportLinks from '../support-links/SupportLinks.astro';
import Voyage from '../voyage/Voyage.astro';
import Water from './Water.astro';

// No copy in between: the full-size file is pure ink and very small, but a resized one gains grey edges and grows.
const plateSrcset = `${plateSmall} 760w, ${plateLarge} 2168w`;
const desktopTextureSrcset = [
  `${desktopTextureOneX} 1440w`,
  `${desktopTextureTwoX} 2880w`,
].join(', ');
const phoneTextureSrcset = [
  `${phoneTextureOneX} 390w`,
  `${phoneTextureTwoX} 780w`,
].join(', ');
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<div class="hero">
  <div
    class="hero__texture hero__texture--desktop"
    aria-hidden="true"
  >
    <picture>
      <source media="(max-width: 47.999rem)" srcset={BLANK} />
      <img
        draggable="false"
        class="hero__texture-image"
        src={desktopTextureOneX}
        srcset={desktopTextureSrcset}
        sizes="100vw"
        decoding="async"
        alt=""
        width="2880"
        height="1070"
      />
    </picture>
  </div>
  <div
    class="hero__texture hero__texture--phone-top"
    aria-hidden="true"
  >
    <picture>
      <source media="(min-width: 48rem)" srcset={BLANK} />
      <img
        draggable="false"
        class="hero__texture-image"
        src={phoneTextureOneX}
        srcset={phoneTextureSrcset}
        sizes="100vw"
        decoding="async"
        alt=""
        width="780"
        height="1688"
      />
    </picture>
  </div>
  <div
    class="hero__texture hero__texture--phone-bottom"
    aria-hidden="true"
  >
    <picture>
      <source media="(min-width: 48rem)" srcset={BLANK} />
      <img
        draggable="false"
        class="hero__texture-image"
        src={phoneTextureOneX}
        srcset={phoneTextureSrcset}
        sizes="100vw"
        decoding="async"
        alt=""
        width="780"
        height="1688"
      />
    </picture>
  </div>
  <header class="hero__header" data-voyage-text>
    <nav aria-label="Site">
      <ul class="hero__nav-list">
        <li>
          <a
            class="hero__nav-link hero__nav-link--muted case-link"
            href="/how-we-check/"
          >
            How we check
          </a>
        </li>
        <li>
          <a class="hero__nav-link hero__nav-link--muted case-link" href="/about/">
            About
          </a>
        </li>
      </ul>
    </nav>
    <SupportLinks />
    <a class="hero__nav-link hero__nav-link--ink hero__nav-start case-link" href="/results/">
      <span>Read the results</span>
      <Icon name="right" />
    </a>
  </header>
  <Water />
  <Voyage />
  <div class="hero__main">
    <h1 class="hero__logo">
      <img src={logoUrl} alt="URUK" width="290" height="98" draggable="false" />
    </h1>
    <p class="hero__intro" data-voyage-text>OpenAI's new mathematics results in plain words, and what mathematicians have checked.</p>
    <img
      id="hero-plate"
      class="hero__plate"
      draggable="false"
      data-bleed
      src={plateSmall}
      srcset={plateSrcset}
      sizes="min(calc(197.166667px + 39.085714vw), 84.444444svh)"
      alt=""
      width="760"
      height="382"
    />
    <a class="hero__button case-link case-link--framed" href="/results/" data-voyage-text>
      <span>Read the results</span>
      <Icon name="right" />
    </a>
    <footer class="hero__foot">
      <span class="hero__scroll" aria-hidden="true" data-voyage-text>
        <span>Scroll</span>
        <Icon name="down" />
      </span>
      <p class="hero__credit" data-voyage-text>
        Plate: ornaments found at Warka (Uruk). W. K. Loftus, 1857. Public
        domain.
      </p>
    </footer>
  </div>
</div>

<style>
  .hero {
    --plate: min(calc(197.166667px + 39.085714vw), 84.444444svh);
    --logo-w: calc(0.365497 * var(--plate) + 12.2222px);
    --logo-left: calc(0.121832 * var(--plate) - 26.5926px);
    --art-gap: calc(0.048733 * var(--plate) - 13.037px);
    --right-edge: calc(
      var(--logo-left) + var(--logo-w) + var(--art-gap) + var(--plate)
    );
    --shift: max(0px, calc((100vw - 1.263158 * var(--right-edge)) / 2));
    --logo-start: calc(var(--shift) + var(--logo-left));
    --plate-start: calc(var(--logo-start) + var(--logo-w) + var(--art-gap));
    --art-h: calc(0.490926 * var(--plate));
    --water-h: calc(0.427632 * var(--plate));
    --water-w: calc(1.894737 * var(--plate));
    --water-left: calc(var(--plate-start) - 0.5 * var(--plate));
    --margin: clamp(16px, calc(1.142857px + 3.809524vw), 56px);
    --nav-top: clamp(32px, calc(25.314286px + 1.714286vw), 50px);
    --foot-pad: clamp(20.5px, calc(10.285714px + 2.619048vw), 48px);
    --nav-gap: clamp(14px, 1.6vw, 22px);
    --hero-nav-font-size: 0.9375rem;
    --hero-foot-font-size: 0.875rem;
    background: var(--paper);
    display: grid;
    grid-column: 1;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows:
      [nav-start] auto
      [nav-end rise-start] minmax(1.5rem, 6.25rem)
      [rise-end air-start] minmax(min-content, 2fr)
      [air-end art-start] var(--art-h)
      [art-end water-start] calc(var(--water-h) - 20.5px)
      [water-end sink-start] minmax(0, 1fr)
      [sink-end foot-start] auto
      [foot-end];
    min-height: 100svh;
    overflow-x: clip;
    position: relative;
  }

  .hero__texture {
    inset: 0;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
    position: absolute;
    z-index: 0;
  }

  .hero__texture-image {
    display: block;
    height: 100%;
    inset: 0;
    object-fit: cover;
    position: absolute;
    width: 100%;
  }

  .hero__texture--desktop {
    grid-column: 1;
    grid-row: nav-start / water-start;
  }

  .hero__texture--desktop .hero__texture-image {
    object-position: 50% 100%;
  }

  .hero__texture--phone-top,
  .hero__texture--phone-bottom {
    display: none;
  }

  .hero__header {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 8px var(--nav-gap);
    grid-column: 1;
    grid-row: nav-start / nav-end;
    justify-content: flex-end;
    padding: var(--nav-top) var(--margin) 0;
    position: relative;
    z-index: 3;
  }

  .hero__nav-list {
    align-items: center;
    display: flex;
    gap: var(--nav-gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero__nav-list > li {
    align-items: center;
    display: flex;
  }

  .hero__header :global(.support-links) {
    gap: var(--nav-gap);
  }

  .hero__header :global(.support-links a) {
    padding-inline: 0;
  }

  .hero__nav-link,
  .hero__scroll,
  .hero__button {
    align-items: center;
    display: inline-flex;
    gap: 6px;
    text-decoration: none;
    white-space: nowrap;
  }

  .hero__nav-link {
    font-family: var(--folio-nav-font-family);
    font-size: var(--hero-nav-font-size);
    font-style: var(--folio-nav-font-style);
    font-weight: var(--folio-nav-font-weight);
    letter-spacing: var(--folio-nav-letter-spacing);
    line-height: var(--folio-nav-line-height);
    text-transform: uppercase;
  }

  .hero__nav-link--muted,
  .hero__scroll {
    color: var(--muted);
  }

  .hero__nav-link--ink {
    color: var(--ink);
  }

  .hero__nav-link :global(svg),
  .hero__scroll :global(svg),
  .hero__button :global(svg) {
    flex: none;
    height: 1em;
    width: 1em;
  }

  .hero__main {
    display: grid;
    grid-column: 1;
    grid-row: rise-start / foot-end;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: subgrid;
    min-width: 0;
    position: relative;
    z-index: 2;
  }

  .hero__logo,
  .hero__plate {
    align-self: end;
    grid-column: 1;
    grid-row: art-start / water-start;
    justify-self: start;
    z-index: 2;
  }

  .hero__logo {
    line-height: 0;
    margin: 0 0 calc(0.010345 * var(--logo-w));
    margin-inline-start: var(--logo-start);
    width: var(--logo-w);
  }

  .hero__logo img {
    display: block;
    height: auto;
    width: 100%;
  }

  .hero__plate {
    display: block;
    height: auto;
    margin: 0 0 calc(-0.011842 * var(--plate));
    margin-inline-start: var(--plate-start);
    width: var(--plate);
  }

  .hero__intro {
    align-self: end;
    color: var(--ink);
    font-family: var(--folio-nav-font-family);
    font-size: var(--hero-nav-font-size);
    font-style: normal;
    font-weight: var(--folio-nav-font-weight);
    grid-column: 1;
    grid-row: air-start / art-start;
    justify-self: start;
    letter-spacing: var(--folio-nav-letter-spacing);
    line-height: 1.45;
    margin: 12px var(--margin) clamp(2rem, 4svh, 3rem) var(--logo-start);
    max-inline-size: 24rem;
    text-transform: uppercase;
    text-wrap: balance;
  }

  @media (min-width: 48rem) {
    .hero__intro {
      align-self: start;
      grid-row: rise-start / art-start;
      margin: 0.75rem var(--margin) 1.5rem;
      max-inline-size: 28rem;
    }
  }

  .hero__button {
    border: 1px solid var(--ink);
    color: var(--ink);
    display: none;
    font-family: var(--folio-nav-font-family);
    font-size: var(--hero-nav-font-size);
    font-style: var(--folio-nav-font-style);
    font-weight: var(--folio-nav-font-weight);
    grid-column: 1;
    grid-row: button-start / button-end;
    justify-self: end;
    letter-spacing: var(--folio-nav-letter-spacing);
    line-height: var(--folio-nav-line-height);
    margin-inline-end: var(--margin);
    padding: 15px 22px;
    position: relative;
    text-transform: uppercase;
    z-index: 3;
  }

  .hero__foot {
    align-items: end;
    column-gap: 1rem;
    display: grid;
    grid-column: 1;
    grid-row: 6;
    grid-template-columns: auto minmax(0, 1fr);
    padding: 0 var(--margin) var(--foot-pad);
    position: relative;
    z-index: 3;
  }

  .hero__scroll {
    font-family: var(--font-special-elite);
    font-size: var(--hero-foot-font-size);
    font-weight: var(--folio-label-font-weight);
    letter-spacing: var(--folio-label-letter-spacing);
    line-height: 1.3;
    text-transform: uppercase;
  }

  .hero__scroll :global(svg) {
    /* Center the drawn arrow against the capitals inside their line box. */
    transform: translateY(-0.25em);
  }

  .hero__credit {
    color: var(--muted);
    font-family: var(--font-special-elite);
    font-size: var(--hero-foot-font-size);
    font-weight: 400;
    letter-spacing: 0;
    justify-self: end;
    line-height: 1.3;
    margin: 0;
    text-align: right;
  }

  /* At 59rem the intro has 16rem beside the widest navigation row and its gap. */
  @media (min-width: 59rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) max-content;
    }

    .hero__header {
      grid-column: 2;
      padding-inline-start: 0;
    }

    .hero__main,
    .hero__texture--desktop,
    .hero > :global(.hero__water),
    .hero__logo,
    .hero__plate,
    .hero__foot {
      grid-column: 1 / -1;
    }

    .hero__main {
      grid-row: nav-start / foot-end;
      grid-template-columns: subgrid;
    }

    .hero__intro {
      grid-column: 1 / 2;
      grid-row: nav-start / nav-end;
      /* Center the first line box within the links' row, below its top padding. */
      inset-block-start: calc(var(--nav-top) + (100% - var(--nav-top) - 1lh) / 2);
      inset-inline: var(--margin) 3rem;
      margin: 0;
      position: absolute;
    }

    .hero__foot {
      grid-row: foot-start / foot-end;
    }
  }

  @media (max-width: 47.999rem) {
    .hero {
      grid-template-rows:
        [nav-start] auto
        [nav-end air-start] minmax(1rem, 1fr)
        [air-end art-start] var(--art-h)
        [art-end water-start] calc(var(--water-h) + 0.75rem)
        [water-end intro-start] auto
        [intro-end button-start] auto
        [button-end sink-start] minmax(1.5rem, 1fr)
        [sink-end foot-start] auto
        [foot-end];
    }

    .hero__texture--desktop {
      display: none;
    }

    .hero__texture--phone-top {
      display: block;
      grid-column: 1;
      grid-row: nav-start / water-start;
    }

    .hero__texture--phone-top .hero__texture-image {
      object-position: 50% 0;
    }

    .hero__texture--phone-bottom {
      display: block;
      grid-column: 1;
      grid-row: water-start / foot-end;
      mask-image: linear-gradient(
        to bottom,
        transparent 0,
        transparent var(--water-h),
        #000 calc(var(--water-h) + 60px),
        #000 calc(100% - 40px),
        transparent 100%
      );
    }

    .hero__texture--phone-bottom .hero__texture-image {
      object-position: 50% 100%;
    }

    .hero__main {
      grid-row: air-start / foot-end;
    }

    .hero__header nav {
      margin-inline-end: 4px;
    }

    .hero__intro {
      align-self: start;
      grid-row: intro-start / intro-end;
      justify-self: end;
      margin: 0 var(--margin) 24px;
      max-inline-size: 17rem;
      text-align: right;
    }

    .hero__nav-start {
      display: none;
    }

    .hero__button {
      display: inline-flex;
    }

    .hero__foot {
      grid-row: foot-start / foot-end;
    }

    .hero__credit {
      max-inline-size: 16rem;
    }
  }
</style>
