<script is:inline>
  (() => {
    const root = document.documentElement;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const intentKey = 'uruk:seal-destination';
    const resultsPath = /^\/results(?:\/(\d{3}))?\/?$/;
    const current = resultsPath.exec(location.pathname);
    let navigationTimeout;

    function clearSeal() {
      delete root.dataset.sealStage;
    }

    function takeArrivalIntent() {
      try {
        const intent = sessionStorage.getItem(intentKey);
        if (!intent) return false;

        sessionStorage.removeItem(intentKey);
        const [from, to, expires] = intent.split('\n');
        return from === document.referrer && to === location.href && Number(expires) > Date.now();
      } catch {
        return false;
      }
    }

    /** @param {() => void} next */
    function afterSealMotion(next) {
      const cover = document.querySelector('.seal-transition');
      const animations = cover?.getAnimations({ subtree: true }) ?? [];
      void Promise.allSettled(animations.map((animation) => animation.finished)).then(next);
    }

    // Set the cover before the destination body can paint. Its first frame matches the closed sheet.
    if (takeArrivalIntent() && !reducedMotion.matches) {
      root.dataset.sealStage = 'arriving';
      document.addEventListener('uruk:result-opening-ready', () => {
        // Paint the closed sheet once before revealing the article's opening.
        requestAnimationFrame(() => requestAnimationFrame(() => {
          root.dataset.sealStage = 'opening';
          afterSealMotion(clearSeal);
        }));
      }, { once: true });
    }

    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        window.clearTimeout(navigationTimeout);
        clearSeal();
      }
    });

    window.addEventListener('click', (event) => {
      if (!current || reducedMotion.matches || event.defaultPrevented || event.button !== 0
        || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      const link = event.target instanceof Element ? event.target.closest('a') : null;
      if (!(link instanceof HTMLAnchorElement) || !link.href || (link.target && link.target !== '_self')
        || link.hasAttribute('download') || link.relList.contains('noreferrer')) return;

      const destination = new URL(link.href);
      const result = resultsPath.exec(destination.pathname)?.[1];
      if (destination.origin !== location.origin || !result || result === current[1]) return;

      if (root.dataset.sealStage) {
        event.preventDefault();
        return;
      }

      try {
        // Keep native navigation when the tab cannot carry the cover to the next document.
        const source = new URL(location.href);
        source.hash = '';
        sessionStorage.setItem(intentKey, [source.href, destination.href, Date.now() + 15000].join('\n'));
      } catch {
        return;
      }

      event.preventDefault();
      root.dataset.sealStage = 'closing';
      afterSealMotion(() => {
        if (root.dataset.sealStage !== 'closing') return;

        root.dataset.sealStage = 'covered';
        location.assign(destination.href);
        // A cancelled or stalled navigation must give the current page back to the reader.
        navigationTimeout = window.setTimeout(clearSeal, 15000);
      });
    });
  })();
</script>

<style is:inline>
  .seal-transition { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    a[href^="/results/"]:not([href="/results/"], [target], [download]) { -webkit-tap-highlight-color: transparent; }

    :root[data-seal-stage] .seal-transition {
      --seal-close-time: 305ms;
      --seal-close-easing: cubic-bezier(.4, .05, .3, 1);
      --seal-scene-open-time: 200ms;
      --seal-roll-start: 145ms;
      --seal-roll-time: 490ms;
      --seal-roll-end: calc(var(--seal-roll-start) + var(--seal-roll-time));
      --seal-roll-easing: cubic-bezier(.42, .1, .32, 1);
      --seal-lift-time: 115ms;
      --seal-print-hold: 150ms;
      --seal-fold-start: calc(var(--seal-roll-end) + var(--seal-lift-time) + var(--seal-print-hold));
      --seal-fold-time: 140ms;
      --seal-open-time: 440ms;
      display: grid;
      inset: 0;
      isolation: isolate;
      place-items: center;
      pointer-events: none;
      position: fixed;
      z-index: 100;
    }

    @media (max-width: 47.999rem), (max-height: 34rem) and (pointer: coarse) {
      :root[data-seal-stage] .seal-transition {
        --seal-close-time: 195ms;
        --seal-scene-open-time: 140ms;
        --seal-roll-start: 85ms;
        --seal-roll-time: 335ms;
        --seal-lift-time: 65ms;
        --seal-print-hold: 50ms;
        --seal-fold-time: 90ms;
        --seal-open-time: 270ms;
      }
    }

    .seal-transition__paper {
      background: var(--paper);
      inset: 0;
      position: absolute;
      z-index: -1;
    }

    .seal-transition__grain {
      inset: 0;
      position: absolute;
      visibility: hidden;
    }

    .seal-transition__grain img { display: block; height: 100%; object-fit: cover; opacity: .7; width: 100%; }

    .seal-transition__scene {
      aspect-ratio: 500 / 180;
      position: relative;
      visibility: hidden;
      width: min(42rem, calc(100% - 1.5rem), calc(70svh * 500 / 180));
    }

    .seal-transition__scene svg { display: block; height: 100%; width: 100%; }
    .seal-transition__print { inset: 0; position: absolute; }
    .seal-transition__roller { inset: 0 auto 0 var(--seal-roller-left); position: absolute; width: var(--seal-roller-width); }

    .seal-transition__rules { fill: none; stroke: var(--muted); stroke-width: .9; }
    .seal-transition__stone { fill: var(--paper); stroke: var(--ink-logo); stroke-width: 1.7; }
    .seal-transition__hatching { fill: none; stroke: var(--ink-logo); stroke-opacity: .42; stroke-width: .85; }

    :root:is([data-seal-stage="covered"], [data-seal-stage="arriving"]) .seal-transition {
      pointer-events: auto;
    }

    :root[data-seal-stage="closing"] .seal-transition__paper {
      animation: seal-close var(--seal-close-time) var(--seal-close-easing) both;
    }

    :root[data-seal-stage="closing"] .seal-transition__grain,
    :root[data-seal-stage="closing"] .seal-transition__scene {
      visibility: visible;
    }

    /* Crop the grain at its natural scale and fold it away before the covered swap. */
    :root[data-seal-stage="closing"] .seal-transition__grain {
      animation: seal-art-open var(--seal-close-time) var(--seal-close-easing) both,
        seal-art-fold var(--seal-fold-time) var(--seal-fold-start) ease-in-out forwards;
    }

    :root[data-seal-stage="closing"] .seal-transition__scene {
      animation: seal-art-open var(--seal-scene-open-time) ease-out both,
        seal-art-fold var(--seal-fold-time) var(--seal-fold-start) ease-in-out forwards;
    }

    /* All three tracks share one distance and clock. The contact point is the print edge. */
    :root[data-seal-stage="closing"] .seal-transition__print {
      animation: seal-print var(--seal-roll-time) var(--seal-roll-start) var(--seal-roll-easing) both;
    }

    :root[data-seal-stage="closing"] .seal-transition__roller {
      animation: seal-roll var(--seal-roll-time) var(--seal-roll-start) var(--seal-roll-easing) both,
        seal-lift var(--seal-lift-time) var(--seal-roll-end) ease-in-out forwards;
    }

    :root[data-seal-stage="closing"] .seal-transition__carving {
      animation: seal-turn var(--seal-roll-time) var(--seal-roll-start) var(--seal-roll-easing) both;
    }

    :root[data-seal-stage="opening"] .seal-transition__paper {
      animation: seal-open var(--seal-open-time) cubic-bezier(.45, 0, .23, 1) both;
    }

    @keyframes seal-close {
      from { transform: scaleY(0); }
      to { transform: scaleY(1); }
    }

    @keyframes seal-open {
      from { transform: scaleY(1); }
      to { transform: scaleY(0); }
    }

    @keyframes seal-art-open {
      from { clip-path: inset(50% 0); }
      to { clip-path: inset(0); }
    }

    @keyframes seal-art-fold {
      from { clip-path: inset(0); }
      to { clip-path: inset(50% 0); }
    }

    @keyframes seal-print {
      from { clip-path: inset(0 var(--seal-print-start) 0 0); }
      to { clip-path: inset(0 var(--seal-print-end) 0 0); }
    }

    @keyframes seal-roll {
      from { transform: translateX(0); }
      to { transform: translateX(var(--seal-roller-distance)); }
    }

    @keyframes seal-turn {
      from { transform: translateX(0); }
      to { transform: translateX(var(--seal-carving-distance)); }
    }

    @keyframes seal-lift {
      from { clip-path: inset(0); }
      to { clip-path: inset(0 0 100% 0); }
    }
  }
</style>
