---
import Seal from './Seal.astro';
import desktopGrain from '../../assets/hero/texture-desktop-1440.webp?url';
import phoneGrain from '../../assets/hero/texture-phone-390.webp?url';
---

<div class="seal-transition" aria-hidden="true">
  <div class="seal-transition__paper"></div>
  <picture class="seal-transition__grain">
    <source media="(max-width: 47.999rem)" srcset={phoneGrain} />
    <img src={desktopGrain} width="1440" height="535" alt="" />
  </picture>
  <Seal />
</div>
