---
// Pause/Play and Reset, on the right of the controls row. Pause is a word only: the approved icons have no play or pause sign yet.
import Reset from './Reset.astro';
---

<div class="plate-buttons">
  <button type="button" class="plate-button case-link case-link--tight" data-play>
    <span data-play-label>Pause</span>
  </button>
  <Reset />
</div>
