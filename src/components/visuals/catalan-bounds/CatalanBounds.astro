---
import Plate from '../../plate/Plate.astro';
import FilmControls from '../../plate/FilmControls.astro';
import FilmSubtitles from '../../plate/FilmSubtitles.astro';
import FilmTranscript from '../../plate/FilmTranscript.astro';
import '../../plate/film.css';
import { renderFormula } from '../../../lib/formulas/render';
import { CATALAN, SUMS } from './catalan';
import { CUES, TIMELINE, SCENES } from './story';
import './catalan-film.css';

const math = (tex: string) => renderFormula(tex, false);

type Label = { id: string; tex: string; tone?: 'blue'; size?: 'large' | 'small'; paper?: true };

const labels: Label[] = [
  { id: 'series', tex: String.raw`1-\frac19+\frac1{25}-\frac1{49}+\cdots`, size: 'large' },
  { id: 'g', tex: 'G', tone: 'blue' },
  { id: 'rational', tex: 'G=a/b', tone: 'blue' },
  { id: 'approximation', tex: String.raw`S_n=p_n/q_n` },
  { id: 'error', tex: String.raw`|G-p_n/q_n|`, size: 'small' },
  { id: 'cleared', tex: String.raw`|q_nG-p_n|`, tone: 'blue', size: 'small' },
  { id: 'integer', tex: String.raw`|b(q_nG-p_n)|=|aq_n-bp_n|`, tone: 'blue', size: 'small' },
  { id: 'determinant', tex: String.raw`\Delta_N`, tone: 'blue', size: 'large' },
  { id: 'matrix-size', tex: String.raw`48N\times48N`, size: 'small' },
  { id: 'entry', tex: String.raw`r+sG+t\zeta(2)`, paper: true },
  { id: 'entry-clean', tex: 'r+sG', tone: 'blue', paper: true },
  { id: 'unwanted', tex: String.raw`t\zeta(2)`, paper: true },
  { id: 'zero', tex: String.raw`\Delta_p=0` },
  { id: 'nonzero', tex: String.raw`\Delta_p\ne0`, tone: 'blue', paper: true },
  { id: 'denominator', tex: String.raw`\text{denominator}=2^{a}\,3^{b}\,5^{c}\,7^{d}\cdots`, size: 'small', paper: true },
  { id: 'integral', tex: String.raw`\int`, tone: 'blue', size: 'large', paper: true },
  { id: 'normalized', tex: String.raw`\mathcal L_N=\frac{\log|\Delta_N|}{(48N)^2}-\tfrac12\log2`, size: 'small', paper: true },
  { id: 'lower', tex: String.raw`\text{floor: }\liminf\mathcal L_N>-2.29084`, size: 'small', paper: true },
  { id: 'upper', tex: String.raw`\text{ceiling: }\limsup\mathcal L_N\le-2.290939875`, tone: 'blue', size: 'small', paper: true },
  { id: 'irrational', tex: String.raw`G\notin\mathbb Q`, tone: 'blue', size: 'large' },
];

for (const [index, sum] of SUMS.slice(0, 6).entries()) {
  const fraction = sum.denominator === 1n ? String(sum.numerator) : String.raw`\frac{${sum.numerator}}{${sum.denominator}}`;

  labels.push({ id: `sum-${index}`, tex: `S_{${index + 1}}=${fraction}` });
}

const opening = SUMS.slice(0, 4);

const x = (value: number) => 40 + 280 * (value - 0.88) / 0.13;

const y = (index: number) => 30 + 44 * index;

const path = opening.map((sum, index) => `${index === 0 ? 'M' : 'L'}${x(sum.value).toFixed(2)} ${y(index)}`).join('');
---

<Plate
  caption="An alternating sum, the cost of clearing its denominators, and the two incompatible bounds in the claimed proof."
  leftOut="the actual determinant entries and their certificates; the proof's detailed estimates; the separate Sun preprint. The proof drawings are schematic."
>
  <uruk-catalan-film class="film-host film-host--classic">
    <div class="cfilm">
      <div class="cfilm-screen" data-film-viewport>
        <canvas
          class="cfilm-canvas"
          role="img"
          aria-label="A film about Catalan's constant. The alternating partial sums approach G, but clearing their denominators loses the small error. A schematic proof map then shows cancellation in a determinant, a nonzero guarantee, and two incompatible bounds. The film's explanation is available in the transcript below."
          data-film-canvas
        ></canvas>

        <div class="cfilm-still" aria-hidden="true">
          <div class="cfilm-still__formula" set:html={math(String.raw`1-\frac19+\frac1{25}-\frac1{49}+\cdots`)} />
          <svg viewBox="0 0 360 250">
            <path d={`M${x(CATALAN)} 12V194`} fill="none" stroke="var(--blue)" stroke-width="1.3" stroke-dasharray="4 4" />
            <path d={path} fill="none" stroke="currentColor" stroke-width="1.4" />
            {opening.map((sum, index) => (
              <>
                <path d={`M${x(CATALAN)} ${y(index)}H${x(sum.value)}`} fill="none" stroke="var(--muted)" stroke-width=".8" />
                <circle cx={x(sum.value)} cy={y(index)} r="3.5" fill="var(--blue)" />
                <text x="12" y={y(index) + 5} class="cfilm-still__number">{index + 1}</text>
              </>
            ))}
            <path d="M40 194H320" fill="none" stroke="currentColor" stroke-width="1" />
            <text x="40" y="217" class="cfilm-still__number" text-anchor="middle">0.88</text>
            <text x={x(1)} y="217" class="cfilm-still__number" text-anchor="middle">1</text>
            <text x={x(CATALAN)} y="241" class="cfilm-still__name" text-anchor="middle">G ≈ 0.9159655…</text>
          </svg>
        </div>

        <div class="cfilm-labels" aria-hidden="true" data-bleed>
          {labels.map((label) => (
            <span
              class:list={['cfilm-label', label.tone && `cfilm-label--${label.tone}`, label.size && `cfilm-label--${label.size}`, { 'cfilm-label--paper': label.paper }]}
              data-label={label.id}
            >
              <span set:html={math(label.tex)} />
            </span>
          ))}
        </div>
      </div>

      <FilmSubtitles cues={CUES} />
    </div>

    <FilmControls id="cfilm-timeline" timeline={TIMELINE} />

    <FilmTranscript cues={CUES} scenes={SCENES}>
      <p class="film-method">How the film is made. The partial sums use exact integer arithmetic to add and reduce fractions. G is computed separately with an accelerated alternating series. The comparison uses the first six partial sums. Their errors shrink, while their errors multiplied by the reduced denominators grow. This is a finite example of the denominator cost; those multiplied errors do not increase at every later step. These sums are not continued-fraction convergents. The charts label their logarithmic scales. The determinant grids, cancellation and two branches are schematic, and do not calculate or check the paper's matrices or certificates. The final bounds are the paper's exact asymptotic bounds for the normalized logarithm along a sequence of nonzero determinants indexed by primes. Their printed thresholds differ by 0.000099875; no finite-index determinant values are shown. The status is the article's assessment as of 18 October 2026.</p>
    </FilmTranscript>
  </uruk-catalan-film>
</Plate>

<script>
  import './element';
</script>
