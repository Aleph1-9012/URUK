---
import Plate from '../../plate/Plate.astro';
import { renderFormula } from '../../../lib/formulas/render';
import { latticeLinkClasses } from './math';
import { CUES, FILM_DURATION, formatTime } from './story';
import './unit-links.css';

const formula = (tex: string) => renderFormula(tex, false);

const escape = (text: string) => text.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');

function subtitle(text: string): string {
  const pieces: string[] = [];
  let position = 0;

  for (const match of text.matchAll(/\$([^$\n]+)\$/g)) {
    pieces.push(escape(text.slice(position, match.index)));
    pieces.push(`<span class="ulfilm-phrase">${formula(match[1] ?? '')}</span>`);
    position = match.index + match[0].length;
  }

  pieces.push(escape(text.slice(position)));

  return pieces.join('');
}

const labels = [
  { id: 'exp-three-halves', tex: String.raw`n^{3/2}`, blue: false },
  { id: 'exp-four-thirds', tex: String.raw`n^{4/3}`, blue: false },
  { id: 'exp-may', tex: String.raw`n^{1.014}`, blue: false },
  { id: 'exp-erdos', tex: String.raw`n^{1+c/\log\log n}`, blue: false },
  { id: 'exp-guess', tex: String.raw`n^{1+o(1)}`, blue: false },
  { id: 'jump-forward', tex: String.raw`d=\tfrac{3+4i}{5}`, blue: true },
  { id: 'jump-reciprocal', tex: String.raw`1/d=\tfrac{3-4i}{5}`, blue: false },
  { id: 'jump-product', tex: String.raw`(z_p-z_q)(w_p-w_q)=1`, blue: false },
  { id: 'jump-ratio', tex: String.raw`\lambda=\tfrac{24+7i}{25}`, blue: true },
];

const stillLinks = latticeLinkClasses(30, 65).map((group) => group.segments.map(({ from, to }) => `M${35 + from.x * 8.6} ${275 - from.y * 8.6}L${35 + to.x * 8.6} ${275 - to.y * 8.6}`).join(''));

const stillPoints = Array.from({ length: 900 }, (_, index) => ({ x: 35 + index % 30 * 8.6, y: 275 - Math.floor(index / 30) * 8.6 }));

const exponentX = (value: number) => 24 + (value - 1) * 540;
---

<Plate
  caption="Points linked at exactly one unit: small sets and grids counted, Erdős's rescaled grid, the caps from two circles and from 1984, Valtr's non-round circles, and the claimed proof that lowers the cap by an unnamed amount using the jump d and its reciprocal 1/d."
  leftOut="the constant sharpening of Ágoston and Pálvölgyi; Katz and Silier's structure and the rigidity approach of Pach, Raz and Solymosi; the May construction's number-field tower; the crossing number inequality; algebraic specialisation and random cuttings; the prediction lemma, histories and conditional copies; the scale S, the bounded case and its determinant; common and rare levels; the subfield, differentiated equations and valuations; the pinned-distance companion paper; Lean. The proof drawings are schematic."
>
  <uruk-unit-links>
    <div class="ulfilm">
      <div class="ulfilm-stage" data-film-viewport>
        <canvas class="ulfilm-canvas" data-film-canvas role="img" aria-label="A film counting equal-length links among points, then comparing possible growth with upper caps on one exponent line. The September claim moves the cap in an unspecified direction. Its proof drawings are schematic, and its status is unreviewed. A full text transcript follows."></canvas>
        <div class="ulfilm-still" aria-hidden="true">
          <div class="ulfilm-still-sheet">
            <svg viewBox="0 0 330 330" role="presentation">
              <text x="165" y="15" text-anchor="middle" fill="var(--ink)" font-family="var(--font-special-elite)" font-size="12">ONE LENGTH, MANY LINKS</text>
              {stillLinks.map((path) => <path d={path} fill="none" stroke="var(--ink)" stroke-width=".5" stroke-opacity=".16" />)}
              {stillPoints.map((point) => <circle cx={point.x} cy={point.y} r=".6" fill="var(--ink)" />)}
              <text x="165" y="297" text-anchor="middle" fill="var(--ink)" font-family="var(--font-special-elite)" font-size="12">900 POINTS · 4,944 LINKS</text>
              <text x="165" y="314" text-anchor="middle" fill="var(--muted)" font-family="var(--font-alegreya)" font-size="13">The old length √65 is now one unit.</text>
            </svg>
          </div>
          <div class="ulfilm-still-exponent">
            <svg viewBox="0 0 330 245" role="presentation">
              <text x="165" y="18" text-anchor="middle" fill="var(--ink)" font-family="var(--font-special-elite)" font-size="11">THE MOST LINKS GROW LIKE</text>
              <text x="165" y="36" text-anchor="middle" fill="var(--ink)" font-family="var(--font-special-elite)" font-size="11">n TO THE POWER …</text>
              <text x="165" y="64" text-anchor="middle" fill="var(--blue)" font-family="var(--font-special-elite)" font-size="10">CLAIMED · HOW MUCH: NOT GIVEN</text>
              <path d={`M${exponentX(4 / 3)} 87H164M171 82L164 87L171 92`} fill="none" stroke="var(--blue)" stroke-width="1.3" stroke-dasharray="4 3" />
              <path d={`M${exponentX(1.014)} 119V109H176`} fill="none" stroke="var(--ink)" />
              <path d={`M176 109H${exponentX(4 / 3)}`} fill="none" stroke="var(--blue)" stroke-dasharray="3 3" />
              <text x="116" y="102" text-anchor="middle" fill="var(--ink)" font-family="var(--font-alegreya)" font-size="12">Where the truth lies, if the claim holds</text>
              <line x1="24" y1="134" x2="294" y2="134" stroke="var(--ink)" />
              {[1, 4 / 3, 3 / 2].map((value) => <><line x1={exponentX(value)} y1="130" x2={exponentX(value)} y2="140" stroke="var(--ink)" /><text x={exponentX(value)} y="156" text-anchor="middle" fill="var(--ink)" font-family="var(--font-alegreya)" font-size="14">{value === 1 ? '1' : value === 4 / 3 ? '4/3' : '3/2'}</text></>)}
              <line x1={exponentX(1.014)} y1="127" x2={exponentX(1.014)} y2="141" stroke="var(--ink)" stroke-width="1.5" />
              <path d={`M${exponentX(1.014)} 143V166L83 178`} fill="none" stroke="var(--muted)" stroke-width=".7" />
              <text x="95" y="192" text-anchor="middle" fill="var(--ink)" font-family="var(--font-special-elite)" font-size="11">1.014 · MAY, CHECKED</text>
              <text x="165" y="221" text-anchor="middle" fill="var(--blue)" font-family="var(--font-special-elite)" font-size="12">SEPTEMBER CLAIM: UNREVIEWED</text>
              <text x="165" y="241" text-anchor="middle" fill="var(--muted)" font-family="var(--font-alegreya)" font-size="12">The May verification is a different proof.</text>
            </svg>
          </div>
        </div>
        <div class="ulfilm-formulas" aria-hidden="true" data-bleed>
          {labels.map((label) => <span class:list={['ulfilm-label', 'ulfilm-label--small', { 'ulfilm-label--blue': label.blue }]} data-label={label.id}><span set:html={formula(label.tex)} /></span>)}
        </div>
      </div>
      <div class="ulfilm-subtitles" aria-hidden="true">
        {CUES.map((cue, index) => <p class:list={['ulfilm-cue', { 'is-active': index === CUES.length - 1 }]} data-cue={index}><span set:html={subtitle(cue.text)} /><span class="ulfilm-citations"> {cue.sources.map((source) => `[${source}]`).join('')}</span></p>)}
      </div>
    </div>
    <div class="ulfilm-controls" data-script-only>
      <div class="ulfilm-buttons">
        <button class="plate-button case-link case-link--tight" type="button" data-play><span data-play-label>Pause</span></button>
        <p class="ulfilm-clock"><span data-film-clock>0:00 / {formatTime(FILM_DURATION)}</span></p>
        <button class="plate-button case-link case-link--tight" type="button" data-film-restart>Restart</button>
      </div>
      <label class="visually-hidden" for="ulfilm-timeline">Film timeline. Arrow keys move one subtitle at a time.</label>
      <input id="ulfilm-timeline" class="ulfilm-timeline" data-film-range type="range" min="0" max={FILM_DURATION} step="100" value="0" />
      <div class="ulfilm-steps">
        <button class="plate-button case-link case-link--tight" type="button" data-film-previous>Previous</button>
        <p>Step through without motion</p>
        <button class="plate-button case-link case-link--tight" type="button" data-film-next>Next</button>
      </div>
    </div>
    <p class="visually-hidden" data-film-status aria-live="polite" aria-atomic="true"></p>
    <details class="ulfilm-transcript">
      <summary class="text-link">Read the film as text</summary>
      <ol>{CUES.map((cue) => <li><h3>{cue.title}</h3><p><span set:html={subtitle(cue.text)} /> {cue.sources.map((source) => <> <a class="citation text-link" href={`#source-${source}`}>[{source}]</a></>)}</p></li>)}</ol>
      <p class="ulfilm-method">How the film is made. Every link count is computed from the points' coordinates. Two distinct points are linked only when their Euclidean separation equals the chosen unit. The opening eight points have three links. The square has four, the two triangles five, and the six-by-six square and triangular patches have 60 and 85. During the shear, the two grid directions stay unit length; the third direction reaches that length at the end.</p>
      <p class="ulfilm-method">For a square grid of k-by-k points and integer squared distance N, the number of unordered links is one half of the sum of (k − |a|)(k − |b|) over all integer pairs satisfying a² + b² = N. The best distances for the displayed sizes are N = 65 at k = 30, giving 4,944 links; N = 325 at k = 60, giving 28,200; and N = 1105 at k = 100, giving 98,176. Counts per point are rounded to two decimal places. The grid rescales the selected distance to one. Thousands of links are drawn in paths grouped by direction.</p>
      <p class="ulfilm-method">The exponent line uses one linear scale from 1 to 3/2. The May mark is 1.014, rounded from Sawin's 1.014114 lower exponent along a sequence of sizes. Its label is offset so it remains readable beside 1. Erdős's construction has an exponent tending to 1; its approaching arrow is schematic. The September paper gives no specific improved exponent. Its dashed arrow shows the direction of the claim and has no endpoint tick or numerical value.</p>
      <p class="ulfilm-method">The two-circle meetings and unit jumps are exact. The proof's grid uses jumps with integer offsets of squared length 25, divided by five. These include axis directions and 3-4-5 directions. The two arrows are the same oriented link in the coordinates z = x + iy and w = x − iy. Its z jump is d, and its w jump is 1/d, the conjugate of d because its modulus is one. Reversing the geometric link would instead give −d in z. The example ratio of (3 + 4i)/5 to (4 + 3i)/5 is (24 + 7i)/25, also of modulus one. The displayed ratio only illustrates division of two unit jumps; it does not model the proof's asymptotically large heights. Arithmetic height measures number-theoretic complexity and differs from complex absolute value: the displayed jumps and ratio all have modulus one. The rectangle drawing records the alternating-product pattern among four retained endpoint pairs p–r, p–r′, p′–r and p′–r′ in the pair graph. The points need not make a Euclidean rectangle. Its height bars and product comparison are schematic.</p>
      <p class="ulfilm-method">Valtr's non-round curve, Székely's crossing picture, the sampled wedges and their information, heights, and the rectangle obstruction are schematic. The film does not reproduce the May number-field construction or verify the September proof. Review statements follow the article's dated evidence. Verification of the May construction concerns a separate lower-bound proof.</p>
    </details>
  </uruk-unit-links>
</Plate>

<script>
  import './element';
</script>
