---
import Plate from '../../plate/Plate.astro';
import FilmControls from '../../plate/FilmControls.astro';
import FilmSubtitles from '../../plate/FilmSubtitles.astro';
import FilmTranscript from '../../plate/FilmTranscript.astro';
import '../../plate/film.css';
import { renderFormula } from '../../../lib/formulas/render';
import { PALETTE, SPINDLE, SPINDLE_EDGES, hexTiles, rulerAt } from './math';
import { CUES, TIMELINE, FILM_DURATION } from './story';
import './five-colours.css';

const formula = (tex: string) => renderFormula(tex, false);

const labels = [
  { id: 'diameter', tex: String.raw`\tfrac45`, blue: false },
  { id: 'gap', tex: String.raw`(\sqrt{21}-2)\cdot\tfrac25>1`, blue: false },
  { id: 'claim', tex: String.raw`6\le\chi(\mathbb R^2)\le7`, blue: true },
  { id: 'waves', tex: String.raw`e^{i\xi\cdot z}`, blue: false },
];

const unit = 74;

const sx = (x: number) => 180 + x * unit;

const sy = (y: number) => 156 - y * unit;

const ruler = rulerAt(FILM_DURATION);

const tilePolygons = hexTiles().map((tile) => ({
  ...tile,
  points: tile.vertices.map((point) => `${sx(point.x)},${sy(point.y)}`).join(' '),
}));

const spindleX = (x: number) => 37.5 + x * 30;

const spindleY = (y: number) => 128 - y * 30;

const spindleSegments = SPINDLE_EDGES.map(([a, b]) => {
  const from = SPINDLE[a];
  const to = SPINDLE[b];

  if (!from || !to) throw new Error('Each spindle edge needs two vertices.');

  return { from, to };
});
---

<Plate
  caption="Colouring the plane so that points one unit apart differ: why four colours are needed and seven suffice, the 2018 step to five, and how the claimed proof rules out five by taming any colouring and trapping the Moser spindle."
  leftOut="de Bruijn–Erdős compactness; earlier measurable and map-type results; the spectral theorem, dual group and Haar measure; the Furstenberg–Zimmer tower and number-field lemma; the easy direction through density points; transition graphs and cyclic centres; the angular and parity arguments for four- and five-cycles; the uncomputed constant; the follow-up work and Lean development. The proof drawings are schematic."
>
  <uruk-five-colours class="film-host">
    <div class="fcfilm">
      <div class="fcfilm-stage" data-film-viewport>
        <canvas class="fcfilm-canvas" data-film-canvas role="img" aria-label="A film about colouring the plane. A unit ruler builds a triangle and a Moser spindle, seven colours tile the plane, and a ledger follows the known bounds before the claimed proof turns wild colourings into tame ones. A complete text transcript follows."></canvas>
        <div class="fcfilm-still" aria-hidden="true">
          <svg class="fcfilm-still-patterns" role="presentation">
            <defs>
              <pattern id="fcfilm-pattern-h" patternUnits="userSpaceOnUse" width="6" height="6"><path d="M0 3H6" stroke="var(--ink)" stroke-width=".6" /></pattern>
              <pattern id="fcfilm-pattern-d" patternUnits="userSpaceOnUse" width="6.6" height="6.6"><path d="M0 6.6L6.6 0M-1 1L1 -1M5.6 7.6L7.6 5.6" stroke="var(--ink)" stroke-width=".6" /></pattern>
              <pattern id="fcfilm-pattern-o" patternUnits="userSpaceOnUse" width="6" height="12"><circle cx="3" cy="3" r=".75" fill="var(--ink)" /><circle cx="0" cy="9" r=".75" fill="var(--ink)" /><circle cx="6" cy="9" r=".75" fill="var(--ink)" /></pattern>
              <pattern id="fcfilm-pattern-v" patternUnits="userSpaceOnUse" width="6" height="6"><path d="M3 0V6" stroke="var(--ink)" stroke-width=".6" /></pattern>
              <pattern id="fcfilm-pattern-a" patternUnits="userSpaceOnUse" width="6.6" height="6.6"><path d="M0 0L6.6 6.6M-1 5.6L1 7.6M5.6 -1L7.6 1" stroke="var(--ink)" stroke-width=".6" /></pattern>
              <pattern id="fcfilm-pattern-x" patternUnits="userSpaceOnUse" width="6" height="6"><path d="M0 3H6M3 0V6" stroke="var(--ink)" stroke-width=".6" /></pattern>
              <clipPath id="fcfilm-still-clip"><rect x="10" y="30" width="340" height="250" /></clipPath>
            </defs>
          </svg>
          <div class="fcfilm-still-sheet">
            <svg viewBox="0 0 360 300" role="presentation">
              <text x="180" y="17" text-anchor="middle" fill="var(--ink)" font-family="var(--font-special-elite)" font-size="13">SEVEN COLOURS SUFFICE</text>
              <g clip-path="url(#fcfilm-still-clip)">
                {tilePolygons.map((tile) => (
                  <>
                    <polygon points={tile.points} class="fcfilm-still-class" style={`--class-colour: var(--five-${tile.classId})`} />
                    <polygon points={tile.points} fill={tile.pattern === 'blank' ? 'none' : `url(#fcfilm-pattern-${tile.pattern})`} stroke="var(--ink)" stroke-width=".75" />
                  </>
                ))}
                <line x1={sx(ruler.start.x)} y1={sy(ruler.start.y)} x2={sx(ruler.end.x)} y2={sy(ruler.end.y)} stroke="var(--paper)" stroke-width="6" />
                <line x1={sx(ruler.start.x)} y1={sy(ruler.start.y)} x2={sx(ruler.end.x)} y2={sy(ruler.end.y)} stroke="var(--blue)" stroke-width="2" />
                {[ruler.start, ruler.end].map((point) => <circle cx={sx(point.x)} cy={sy(point.y)} r="4" fill="var(--paper)" stroke="var(--blue)" stroke-width="1.5" />)}
              </g>
              <text x="180" y="298" text-anchor="middle" fill="var(--blue)" font-family="var(--font-special-elite)" font-size="12">THE BLUE RULER IS ONE UNIT LONG</text>
            </svg>
          </div>
          <div class="fcfilm-still-ledger">
            <svg viewBox="0 0 320 170" role="presentation">
              <text x="160" y="16" text-anchor="middle" fill="var(--blue)" font-family="var(--font-special-elite)" font-size="15">6–7 CLAIMED · UNDER REVIEW</text>
              <path d="M242 38V29H298V38" fill="none" stroke="var(--blue)" stroke-width="1.5" stroke-dasharray="3 3" />
              {PALETTE.map((pigment, index) => (
                <g style={`--class-colour: var(--five-${pigment.id})`}>
                  <rect x={10 + index * 44} y="43" width="35" height="34" class="fcfilm-still-class" stroke="var(--ink)" stroke-width=".8" />
                  <rect x={10 + index * 44} y="43" width="35" height="34" fill={pigment.pattern === 'blank' ? 'none' : `url(#fcfilm-pattern-${pigment.pattern})`} />
                  <circle cx={27.5 + index * 44} cy="60" r="10" class="fcfilm-still-disc" stroke="var(--ink)" stroke-width=".8" />
                  <text x={27.5 + index * 44} y="65" text-anchor="middle" fill={`var(--${pigment.numeral})`} font-family="var(--font-special-elite)" font-size="14">{pigment.id}</text>
                </g>
              ))}
              <rect x="10" y="89" width="107" height="73" fill="none" stroke="var(--muted)" />
              {spindleSegments.map(({ from, to }) => <line x1={spindleX(from.x)} y1={spindleY(from.y)} x2={spindleX(to.x)} y2={spindleY(to.y)} stroke="var(--ink)" stroke-width=".8" />)}
              {SPINDLE.map((point) => <circle cx={spindleX(point.x)} cy={spindleY(point.y)} r="2.4" fill="var(--ink)" />)}
              <text x="63.5" y="155" text-anchor="middle" fill="var(--ink)" font-family="var(--font-special-elite)" font-size="11">7 POINTS · NEEDS 4</text>
              <text x="220" y="99" text-anchor="middle" fill="var(--muted)" font-family="var(--font-special-elite)" font-size="12">2018: 1,581 · 2020: 509</text>
              <rect x="133" y="111" width="178" height="51" fill="none" stroke="var(--blue)" stroke-dasharray="4 3" />
              <text x="222" y="131" text-anchor="middle" fill="var(--blue)" font-family="var(--font-special-elite)" font-size="12">A PATTERN NEEDING SIX</text>
              <text x="222" y="150" text-anchor="middle" fill="var(--muted)" font-family="var(--font-alegreya)" font-size="14">Claimed to exist; not found</text>
            </svg>
          </div>
        </div>
        <div class="fcfilm-formulas" aria-hidden="true" data-bleed>
          {labels.map((label) => <span class:list={['fcfilm-label', 'fcfilm-label--small', { 'fcfilm-label--blue': label.blue }]} data-label={label.id}><span set:html={formula(label.tex)} /></span>)}
          <span class="fcfilm-label fcfilm-status" data-label="status"><span>UNDER REVIEW</span></span>
        </div>
      </div>
      <FilmSubtitles cues={CUES} />
    </div>
    <FilmControls id="fcfilm-timeline" timeline={TIMELINE} />
    <FilmTranscript cues={CUES}>
      <p class="film-method">How the film is made. The triangle and Moser spindle use exact geometric constructions. The spindle has seven vertices and eleven pairs at distance one. Its two rhombuses turn by <span set:html={formula(String.raw`2\arcsin(1/(2\sqrt3))`)} />, about 33.557 degrees, so their far tips are one unit apart. Testing its finite colour assignments gives no proper three-colouring and 384 proper four-colourings.</p>
      <p class="film-method">The hexagons have circumradius <span set:html={formula(String.raw`\tfrac25`)} />. Their classes follow the index-seven rule on axial coordinates. A single hexagon has diameter <span set:html={formula(String.raw`\tfrac45`)} />. The gap between the closest same-coloured hexagons is <span set:html={formula(String.raw`\tfrac25\sqrt7`)} />, which exceeds one. The on-screen gap formula is the paper's slightly smaller lower bound. The unit ruler keeps its exact length. Colours also have engraving patterns and points carry numerals, so the class labels can be read without colour vision.</p>
      <p class="film-method">De Grey's and Parts's finite graphs are cited by their sizes, not drawn. The wild and tame fields, algebraic-coordinate sample, averaging, waves, uniform remainder, local palettes and cycle are schematic. A tame five-colouring cannot actually exist if the claimed proof is correct. Its drawing only illustrates the hypothetical object the proof rules out. The spindle in the last scene is exact, but its placement inside a three-colour region is schematic. The article does not supply the paper's rational placement certificate. The film follows the article's dated review status and does not verify the proof.</p>
    </FilmTranscript>
  </uruk-five-colours>
</Plate>

<script>
  import './element';
</script>
