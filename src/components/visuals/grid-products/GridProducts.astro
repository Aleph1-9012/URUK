---
import Plate from '../../plate/Plate.astro';
import FilmControls from '../../plate/FilmControls.astro';
import FilmSubtitles from '../../plate/FilmSubtitles.astro';
import FilmTranscript from '../../plate/FilmTranscript.astro';
import '../../plate/film.css';
import { renderFormula } from '../../../lib/formulas/render';
import { A, B, SCHOOL_PRODUCT, STRASSEN_PRODUCTS, RECORDS, WALL, CLAIM } from './math';
import { CUES, TIMELINE } from './story';
import './grid-products.css';

const formula = (tex: string) => renderFormula(tex, false);

const labels = [
  { id: 'school', tex: 'n^3', blue: false },
  { id: 'omega', tex: String.raw`n^{\omega}`, blue: false },
  { id: 'floor', tex: 'n^2', blue: false },
  { id: 'recursion', tex: String.raw`7^k=n^{\log_2 7}\approx n^{2.807}`, blue: false },
  { id: 'character', tex: 'm^{3t}', blue: false },
  { id: 'blocks', tex: '(2^{3t})^2=4^{3t}', blue: false },
  { id: 'points', tex: 'a+b-1=7', blue: true },
  { id: 'tripling', tex: String.raw`P(a,3h+a-1)\ge3P(a,h)`, blue: false },
  { id: 'lower', tex: 'a^{4/3}', blue: false },
  { id: 'upper', tex: '(2a-1)^{1/t}', blue: true },
  { id: 'claim', tex: String.raw`\omega\le\frac94`, blue: true },
  { id: 'pointer', tex: String.raw`3t\le\frac94`, blue: true },
];

const chartX = (year: number) => 36 + (year - 1965) / 65 * 248;

const chartY = (bound: number) => 210 - (bound - 2) * 170;

let stair = `M${chartX(1965)} ${chartY(3)}`;

for (const record of RECORDS) {
  if (!record.claimed) stair += `H${chartX(record.year)}V${chartY(record.bound)}`;
}

const latest = RECORDS.findLast((record) => !record.claimed);

if (!latest) throw new Error('The still needs the last record before the claim.');
---

<Plate
  caption="Why two grids take n³ multiplications the school way, how Strassen's seven products and fifty-seven years of records brought the exponent to 2.371177, and how the claimed proof squeezes it to 9/4."
  leftOut="the 2.3725 barrier; border rank, the asymptotic sum inequality and laser method; why a bound on ν bounds ω; Fourier separation and determinant filtration; the proof of Lemma 4.1; Strassen's spectrum theorem and appendix; the practical crossover; the rectangular and all-fields follow-ups. The character meters and test value t = 0.9 are schematic."
>
  <uruk-grid-products class="film-host">
    <div class="gfilm">
      <div class="gfilm-stage" data-film-viewport>
        <canvas class="gfilm-canvas" data-film-canvas role="img" aria-label="A film counting the work of multiplying grids, showing Strassen's seven products and the history of the exponent, then illustrating the claimed proof with polynomial products and two bounds. A full text transcript follows."></canvas>
        <div class="gfilm-still" aria-hidden="true">
          <div class="gfilm-still-board">
            <p class="gfilm-still-title">TWO GRIDS AND THEIR PRODUCT</p>
            <div class="gfilm-still-equation">
              <div class="gfilm-still-matrix">{A.map((value) => <span>{value}</span>)}</div>
              <span>×</span>
              <div class="gfilm-still-matrix">{B.map((value) => <span>{value}</span>)}</div>
              <span>=</span>
              <div class="gfilm-still-matrix">{SCHOOL_PRODUCT.map((value) => <span>{value}</span>)}</div>
            </div>
            <div class="gfilm-still-chips">{STRASSEN_PRODUCTS.map((product) => <span class="gfilm-still-chip">{product.value}</span>)}</div>
            <p class="gfilm-still-note">Strassen's seven multiplications.<br />The school method takes eight.</p>
          </div>
          <div class="gfilm-still-chart">
            <svg viewBox="0 0 320 258" role="presentation">
              <defs><pattern id="gfilm-still-hatch" width="7" height="7" patternUnits="userSpaceOnUse"><path d="M0 7L7 0" stroke="var(--muted)" stroke-width=".6" /></pattern></defs>
              <text x="160" y="14" text-anchor="middle" font-family="var(--font-special-elite)" font-size="10" fill="var(--ink)">ω: THE POWER OF n IN THE WORK</text>
              <line x1="36" y1="40" x2="36" y2="210" stroke="var(--muted)" />
              <line x1="36" y1="210" x2="284" y2="210" stroke="var(--ink)" />
              {[2, 2.5, 3].map((value) => <text x="27" y={chartY(value) + 4} text-anchor="end" font-family="var(--font-alegreya)" font-size="12" fill="var(--ink)">{value}</text>)}
              <path d={stair} fill="none" stroke="var(--ink)" stroke-width="1.5" />
              <rect x="36" y={chartY(WALL)} width="248" height="9" fill="url(#gfilm-still-hatch)" />
              <line x1="36" y1={chartY(WALL)} x2="284" y2={chartY(WALL)} stroke="var(--muted)" />
              <text x="215" y={chartY(WALL) - 26} text-anchor="middle" font-family="var(--font-alegreya)" font-size="12" fill="var(--muted)">Method barrier 2.3078</text>
              <line x1={chartX(2026)} y1={chartY(latest.bound)} x2={chartX(2026)} y2={chartY(CLAIM)} stroke="var(--blue)" stroke-width="1.5" stroke-dasharray="3 3" />
              <circle cx={chartX(2026)} cy={chartY(CLAIM)} r="4" fill="var(--blue)" />
              <text x="269" y={chartY(CLAIM) + 20} text-anchor="end" font-family="var(--font-alegreya)" font-size="13" fill="var(--blue)">Claim: 2.25</text>
              <text x="120" y="63" text-anchor="middle" font-family="var(--font-alegreya)" font-size="12" fill="var(--ink)">1969: 2.807</text>
              <text x="222" y="107" text-anchor="middle" font-family="var(--font-alegreya)" font-size="12" fill="var(--ink)">2026: 2.371177</text>
              {[1969, 1990, 2026].map((year) => <text x={chartX(year)} y="229" text-anchor="middle" font-family="var(--font-alegreya)" font-size="11" fill="var(--muted)">{year}</text>)}
              <text x="160" y="249" text-anchor="middle" font-family="var(--font-special-elite)" font-size="9" fill="var(--blue)">CLAIMED · UNDER REVIEW</text>
            </svg>
          </div>
        </div>
        <div class="gfilm-formulas" aria-hidden="true" data-bleed>
          {labels.map((label) => <span class:list={['gfilm-label', 'gfilm-label--small', { 'gfilm-label--blue': label.blue }]} data-label={label.id}><span set:html={formula(label.tex)} /></span>)}
          <span class="gfilm-label gfilm-status" data-label="status"><span>CLAIMED · UNDER REVIEW</span></span>
        </div>
      </div>
      <FilmSubtitles cues={CUES} />
    </div>
    <FilmControls id="gfilm-timeline" timeline={TIMELINE} />
    <FilmTranscript cues={CUES}>
      <p class="film-method">How the film is made. The two sample matrices, their product and Strassen's seven products are computed. Strassen's displayed recipe uses eighteen additions or subtractions in total, alongside seven multiplications. The school recipe uses four additions and eight multiplications. The recursive counts are <span set:html={formula('8^k')} /> and <span set:html={formula('7^k')} />. The chart follows the record table cited by the article, with the October 2026 claim distinguished from earlier records.</p>
      <p class="film-method">The sixteen polynomial products have seven coefficient sums. Evaluation at seven points uses seven bilinear multiplications; evaluating and interpolating still require linear arithmetic. The tripling grid follows the paper's Lemma 3.4 and Figure 3.1 with <span set:html={formula(String.raw`a=3,\ h=2`)} />. Six products are removed, leaving six in each of the three sectors.</p>
      <p class="film-method">The squeeze curves are evaluated from their formulas on logarithmic axes. Both equal 1 at <span set:html={formula('a=1')} />. The moving crossing is the second intersection, with <span set:html={formula('a>1')} />. At <span set:html={formula(String.raw`t=\frac34`)} /> the upper curve remains strictly above the lower one for every <span set:html={formula('a>1')} />. The character meters, their appearance, the hypothetical test value and the unconstructed recipe are schematic. These drawings illustrate the argument; they do not verify its proof.</p>
    </FilmTranscript>
  </uruk-grid-products>
</Plate>

<script>
  import './element';
</script>
