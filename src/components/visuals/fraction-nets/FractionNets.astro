---
import Film from '../../plate/Film.astro';
import { renderFormula } from '../../../lib/formulas/render';
import { CUES, TIMELINE, SCENES } from './story';
import './style.css';

const math = (tex: string) => renderFormula(tex, false);
type Anchor = 'above' | 'right';

const labels: { id: string; tex: string; anchor: Anchor; tone?: 'blue'; size?: 'small'; halo?: true }[] = [
  { id: 'cubic', tex: String.raw`x^{3}+y^{3}=6`, anchor: 'right', halo: true },
  { id: 'found', tex: String.raw`\bigl(\tfrac{17}{21}\bigr)^{3}+\bigl(\tfrac{37}{21}\bigr)^{3}=6`, anchor: 'right', tone: 'blue', size: 'small', halo: true },
  { id: 'circle', tex: String.raw`x^{2}+y^{2}=3`, anchor: 'right', halo: true },
  { id: 'curve', tex: String.raw`y^{2}=x^{3}-25x`, anchor: 'right', size: 'small', halo: true },
  { id: 'p', tex: String.raw`P`, anchor: 'right', tone: 'blue', halo: true },
  { id: 'p3', tex: String.raw`3P`, anchor: 'right', tone: 'blue', size: 'small', halo: true },
  { id: 'p4', tex: String.raw`4P`, anchor: 'right', tone: 'blue', size: 'small', halo: true },
  { id: 'p5', tex: String.raw`5P`, anchor: 'right', tone: 'blue', size: 'small', halo: true },
  { id: 'zstar', tex: String.raw`{}^{*}\mathbb{Z}`, anchor: 'above', halo: true },
  { id: 'growth', tex: String.raw`h\approx c\,B^{2}`, anchor: 'right', size: 'small', halo: true },
  { id: 'bound', tex: String.raw`h\le C\,B`, anchor: 'right', size: 'small', halo: true },
];
---

<Film
  tag="uruk-fraction-nets"
  cues={CUES}
  timeline={TIMELINE}
  scenes={SCENES}
  layout="classic"
  description="An animated film, drawn from computed values. A computer casts finer and finer nets of fractions over the curve x cubed plus y cubed equals 6 and catches a solution on the net of 21sts, but no net catches a point of x squared plus y squared equals 3, where a remainder argument settles it. The whole numbers then drop their shadow onto a line, a curve with two pieces drops two stretches, and the proof ends with growing points that a bound can't hold for ever. Its subtitles are also in the transcript below."
  caption="A film from a computer's nets of fractions to the paper's claim: why a search can't say “none”, why the old route was blocked, and the clash of sizes at the heart of the proof."
>
  <Fragment slot="labels">
    {labels.map((label) => (
      <span class:list={['film-label', `film-label--${label.anchor}`, label.tone && `film-label--${label.tone}`, label.size && `film-label--${label.size}`, { 'film-label--halo': label.halo }]} data-label={label.id}>
        <span set:html={math(label.tex)} />
      </span>
    ))}
  </Fragment>
  <p class="film-method">How the film is made. The net of c is every point (a/c, b/c) with whole a and b; the film shows the nets of 1, 2, 3 and so on in turn. Over the whole picture the finer nets would be a grey smudge (11,881 knots at c = 21), so the camera closes in on a window as the nets get finer and keeps the knots at least 7 pixels apart. In that window the first net with a knot exactly on x³ + y³ = 6 is the net of 21sts, at (17/21, 37/21) and (37/21, 17/21); a³ + b³ = 6c³ is checked in whole numbers. No net up to 60ths has a knot on x² + y² = 3. The ringed knot on each net is the one nearest the circle, by |a² + b² − 3c²|; the miss shrinks (0.04 at c = 5, 0.0023 at c = 21, 0.00063 at c = 40) but never reaches 0, and the remainders of squares on division by 3 show it never can. The shadow reading of Mazur's observation follows the article: an equation that picks out the whole numbers would have solutions whose first coordinates are exactly the whole numbers, and finitely many pieces can only cast finitely many stretches. The curve on screen is a small example, y² = x³ − 25x with P = (−4, 6); its multiples are found by the chord rule in exact fraction arithmetic, and the dots that fill its two pieces use the same steps in floating point, within a millionth of the exact points. The paper's own curve is E: y² = x³ − d²x over Q(√2), with d = 75 − 53√2; under either real embedding d is positive, and scaling turns both curves into v² = u³ − u, so they have the same shape. The chart counts the digits of x(nP), about 0.83 n². The test boxes, the two cursors, the stretched line with its larger number system and the line C·B are schematic.</p>
</Film>

<script>
  import './element';
</script>
