---
import { renderFilmText } from '../../plate/text';
import Film from '../../plate/Film.astro';
import { renderFormula } from '../../../lib/formulas/render';
import { CROSSING_RULES, GROUP_COUNTS, GROUP_RULES, TRUE_COUNT, type Rule } from './sat';
import { CUES, TIMELINE, SCENES } from './story';
import './style.css';

const math = (tex: string) => renderFormula(tex, false);

const literal = (value: number) => `${value < 0 ? '\\neg ' : ''}x_{${Math.abs(value)}}`;

const clause = (rule: Rule) => `(${rule.map(literal).join('\\vee ')})`;

const listed = (rules: readonly Rule[]) => rules.map((rule) => `$${clause(rule)}$`).join(', ');

type Label = { id: string; tex: string; tone?: 'blue'; size?: 'small' | 'large' };

const labels: Label[] = [
  { id: 'formula', tex: String.raw`(x_1\vee x_2\vee x_3)\wedge(\neg x_1\vee\neg x_2\vee\neg x_3)`, size: 'small' },
  { id: 'power', tex: '2^n' },
  { id: 'better', tex: String.raw`\approx1.33^n` },
  { id: 'threshold', tex: String.raw`n=2^{10^{10}}`, size: 'small' },
  { id: 'tries', tex: String.raw`3\times2^4=48\text{ tries, not }2^{12}=4096`, size: 'small' },
  { id: 'dial', tex: 'T', tone: 'blue', size: 'large' },
  { id: 'dial-zero', tex: String.raw`T=0\text{: the true count}`, size: 'small' },
  { id: 'dial-stops', tex: String.raw`T=1,\ldots,Q`, size: 'small' },
  { id: 'bent', tex: 'H(T)', tone: 'blue' },
  { id: 'landing', tex: `H(0)=${TRUE_COUNT}`, tone: 'blue' },
  { id: 'subexp', tex: '2^{o(n)}', tone: 'blue' },
];
---

<Film
  tag="uruk-switch-groups"
  cues={CUES}
  timeline={TIMELINE}
  scenes={SCENES}
  layout="classic"
  description="A film about the Exponential Time Hypothesis. Switches and rules are counted by trying every setting, and a chart shows what one more switch costs: twice as much by trying everything, about 1.33 times with cleverer methods, and a floor the hypothesis says no method gets under. A curve shows the claimed method, which only bends below that floor beyond 2 to the power 10 to the 10 switches. A schematic of the claimed proof follows: groups of switches, shared summaries, and a dial T. The film's explanation is in the transcript below."
  caption="Counting the settings that obey every rule, what each extra switch costs, and the claimed way to make that cost shrink."
  leftOut="the construction of the summaries (Sections 2.7 and 4); the reduction from any clause width to three occurrences per switch (Sections 2.8 and 6); the sharper exponent of Appendix D; the Lean formalization of a weaker form, and Anthropic's independent claim, which the article describes. The proof drawings are schematic."
>
  <Fragment slot="labels">
    {labels.map((label) => (
      <span class:list={['film-label', label.tone && `film-label--${label.tone}`, label.size && `film-label--${label.size}`]} data-label={label.id}>
        <span set:html={math(label.tex)} />
      </span>
    ))}
  </Fragment>
  <p class="film-method" set:html={renderFilmText(`How the film is made. Every count is computed by trying all settings: 6 of the opening's 8; for each group of four switches, 10 of 16 under its three rules (${listed(GROUP_RULES.flat())}); ${GROUP_COUNTS.join(' × ')} = 1,000 for those nine rules together; and ${TRUE_COUNT} of 4,096 once the crossing rules ${listed(CROSSING_RULES)} are added. Each switch occurs in exactly three rules, as in the paper's Section 2, where each occurs in at most three. The bars double exactly. The flat lines are the article's figures: $4/3$ for Schöning's method, about 1.328 for the best deterministic method before the paper, and about 1.308 for PPSZ. The hypothesis names no height for its floor, so the floor is drawn at an arbitrary one. The threshold is the article's own solution of the paper's parameter constraints, $\\lceil\\log_2n\\rceil\\approx1.09\\times10^{10}$, so $n$ is beyond $2^{10^{10}}$, a number with about 3.3 billion digits; the paper does not state it. The claimed curve's descent, the dial, the summaries and their routing, and the three costs are schematic. The bent count is a real polynomial of degree 5, made up for the drawing: its values and slopes at $T=1,2,3$ determine it exactly, and its value at $T=0$ is the count ${TRUE_COUNT}, as the paper's recovery requires of its real polynomial, whose degree is far higher. The status is the article's as of 1 November 2026.`)} />
</Film>

<script>
  import './element';
</script>
