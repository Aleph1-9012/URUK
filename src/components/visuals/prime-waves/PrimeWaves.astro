---
import Film from '../../plate/Film.astro';
import { renderFormula } from '../../../lib/formulas/render';
import { CUES, TIMELINE, SCENES } from './story';
import './style.css';

const math = (tex: string) => renderFormula(tex, false);
type Anchor = 'above' | 'right';

const labels: { id: string; tex: string; anchor: Anchor; tone?: 'blue'; size?: 'large' | 'small'; halo?: true }[] = [
  { id: 'pi', tex: String.raw`\pi(x)`, anchor: 'right' },
  { id: 'li', tex: String.raw`\mathrm{Li}(x)`, anchor: 'right' },
  { id: 'x-beta', tex: String.raw`x^{\beta}`, anchor: 'right', tone: 'blue' },
  { id: 'x-edge', tex: String.raw`x^{1}`, anchor: 'right' },
  { id: 'x-claim', tex: String.raw`x^{7/8}`, anchor: 'right', tone: 'blue' },
  { id: 'zeta-sum', tex: String.raw`\zeta(s)=1+\frac{1}{2^{s}}+\frac{1}{3^{s}}+\cdots`, anchor: 'above', size: 'large' },
  { id: 'zeta-card', tex: String.raw`\zeta(s)`, anchor: 'above', size: 'small' },
  { id: 'cousin', tex: String.raw`L(s,\chi_{-4})`, anchor: 'above', size: 'small' },
  { id: 'eisenstein', tex: String.raw`a+b\omega,\ \ \omega=e^{2\pi i/3}`, anchor: 'above', size: 'small' },
  { id: 'reciprocal', tex: String.raw`1/\zeta\ \text{large}`, anchor: 'right', halo: true },
];
---

<Film
  tag="uruk-prime-waves"
  cues={CUES}
  timeline={TIMELINE}
  scenes={SCENES}
  layout="classic"
  description="An animated film, drawn from computed values. It counts the primes up to 100, rebuilds the count from waves given by the zeros of the zeta function, shows how a zero's place sets the size of its wave, and ends with the claimed boundary at seven eighths and the shape of the argument. Its subtitles are also in the transcript below."
  caption="A film from the primes to the paper's claim: their count, the waves from the zeros of ζ that rebuild it, the claimed fence at 7/8 and the shape of the proof."
>
  <Fragment slot="labels">
    {labels.map((label) => (
      <span class:list={['film-label', `film-label--${label.anchor}`, label.tone && `film-label--${label.tone}`, label.size && `film-label--${label.size}`, { 'film-label--halo': label.halo }]} data-label={label.id}>
        <span set:html={math(label.tex)} />
      </span>
    ))}
  </Fragment>
  <p class="film-method">How the film is made. The staircase counts the primes up to 100, and the dashed curve is Li(x), the integral of 1/log t from 2. The blue curve is Riemann's explicit formula: a smooth part (li(x) with its corrections from x^(1/2), x^(1/3), …, and two small constants) plus one wave for each pair of zeros among the first hundred of Odlyzko's table [5]. The waves add to that smooth part, not to Li(x) itself, which is why the rebuilt curve lands on the staircase. The single wave is the first zero's, moved across the strip to show what its real part does; no zero is known off the line ½. The maps are computed by Euler–Maclaurin sums for ζ and for L(s, χ₋₄), drawn as lines where the value points in one of eight directions, so eight lines meet at every zero. The rings around ζ's zeros are where |ζ| is small, so 1/ζ is large. The grid is the Eisenstein integers a + bω, with the norms 1, 3, 4 and 7 circled. The supposed zero, the squeeze and the rows of arrows are schematic.</p>
</Film>

<script>
  import './element';
</script>
