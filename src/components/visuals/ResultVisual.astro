---
import type { AstroInstance } from 'astro';
import { visualCatalog, type VisualKey } from '../../content/visuals';

interface Props {
  visual: VisualKey;
}

type VisualComponent = AstroInstance['default'];

const modules = import.meta.glob<{ default: VisualComponent }>('./*/*.astro', { eager: true });
const plates = new Map<VisualKey, VisualComponent>();

for (const { key, component } of visualCatalog) {
  const loaded = modules[component];

  if (!loaded) {
    throw new Error(`Visual ${key} has no component at ${component}.`);
  }

  plates.set(key, loaded.default);
}

const Visual = plates.get(Astro.props.visual);

if (!Visual) {
  throw new Error(`Unregistered visual: ${Astro.props.visual}`);
}
---

<Visual />
