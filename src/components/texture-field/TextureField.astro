---
import desktop0 from '../../assets/texture/desktop/wave-0.webp?url';
import desktop1 from '../../assets/texture/desktop/wave-1.webp?url';
import desktop2 from '../../assets/texture/desktop/wave-2.webp?url';
import desktop3 from '../../assets/texture/desktop/wave-3.webp?url';
import phone0 from '../../assets/texture/phone/wave-0.webp?url';
import phone1 from '../../assets/texture/phone/wave-1.webp?url';
import phone2 from '../../assets/texture/phone/wave-2.webp?url';
import phone3 from '../../assets/texture/phone/wave-3.webp?url';
import phone4 from '../../assets/texture/phone/wave-4.webp?url';
import phone5 from '../../assets/texture/phone/wave-5.webp?url';

const desktopImages = [
  { url: desktop0, width: 1440, height: 2048 },
  { url: desktop1, width: 1440, height: 2048 },
  { url: desktop2, width: 1440, height: 2048 },
  { url: desktop3, width: 1440, height: 1646 },
];
const phoneImages = [
  { url: phone0, width: 390, height: 2048 },
  { url: phone1, width: 390, height: 2048 },
  { url: phone2, width: 390, height: 2048 },
  { url: phone3, width: 390, height: 2048 },
  { url: phone4, width: 390, height: 2048 },
  { url: phone5, width: 390, height: 2029 },
];
---

<uruk-texture-field aria-hidden="true" data-bleed>
  <div class="texture-field__stack texture-field__stack--desktop" data-texture-stack>
    {desktopImages.map((image) => (
      <img
        draggable="false"
        src={image.url}
        loading="lazy"
        decoding="async"
        alt=""
        width={image.width}
        height={image.height}
      />
    ))}
  </div>
  <div class="texture-field__stack texture-field__stack--phone" data-texture-stack>
    {phoneImages.map((image) => (
      <img
        draggable="false"
        src={image.url}
        loading="lazy"
        decoding="async"
        alt=""
        width={image.width}
        height={image.height}
      />
    ))}
  </div>
</uruk-texture-field>

<script>
  function clonePosition(cloneIndex: number, sourceCount: number): { sourceIndex: number; flipped: boolean } {
    const pass = Math.floor(cloneIndex / sourceCount);
    const within = cloneIndex % sourceCount;
    const flipped = pass % 2 === 0;

    return {
      sourceIndex: flipped ? sourceCount - 1 - within : within,
      flipped,
    };
  }

  class UrukTextureField extends HTMLElement {
    private observer: ResizeObserver | undefined;
    private readonly update = () => {
      const page = this.parentElement;

      if (!page) {
        return;
      }

      const pageHeight = page.getBoundingClientRect().height;

      for (const stack of this.querySelectorAll<HTMLElement>('[data-texture-stack]')) {
        if (window.getComputedStyle(stack).display === 'none') {
          continue;
        }

        this.extendStack(stack, pageHeight);
      }
    };

    connectedCallback(): void {
      this.observer = new ResizeObserver(this.update);
      if (this.parentElement) {
        this.observer.observe(this.parentElement);
      }
      for (const image of this.querySelectorAll<HTMLImageElement>(
        '[data-texture-stack] > img:not([data-repeat])',
      )) {
        image.addEventListener('load', this.update, { once: true });
      }
      this.update();
    }

    disconnectedCallback(): void {
      this.observer?.disconnect();
      for (const image of this.querySelectorAll<HTMLImageElement>(
        '[data-texture-stack] > img:not([data-repeat])',
      )) {
        image.removeEventListener('load', this.update);
      }
    }

    private extendStack(stack: HTMLElement, pageHeight: number): void {
      const sources: HTMLImageElement[] = [];
      const sourceHeights: number[] = [];
      const clones = stack.querySelectorAll<HTMLImageElement>('img[data-repeat]');

      for (const image of stack.querySelectorAll<HTMLImageElement>(':scope > img:not([data-repeat])')) {
        sources.push(image);
      }

      if (sources.length === 0) {
        for (const clone of clones) {
          clone.remove();
        }

        return;
      }

      let stackHeight = 0;

      for (const source of sources) {
        const sourceHeight = source.getBoundingClientRect().height;
        sourceHeights.push(sourceHeight);
        stackHeight += sourceHeight;
      }

      if (stackHeight === 0) {
        for (const clone of clones) {
          clone.remove();
        }

        return;
      }

      let requiredHeight = stackHeight;
      let requiredClones = 0;

      while (requiredHeight < pageHeight) {
        const { sourceIndex } = clonePosition(requiredClones, sources.length);
        const sourceHeight = sourceHeights[sourceIndex];

        if (sourceHeight === undefined) {
          break;
        }

        requiredHeight += sourceHeight;
        requiredClones += 1;
      }

      for (let index = clones.length - 1; index >= requiredClones; index -= 1) {
        const clone = clones.item(index);

        if (clone) {
          clone.remove();
        }
      }

      const existingClones = Math.min(clones.length, requiredClones);

      for (let cloneIndex = existingClones; cloneIndex < requiredClones; cloneIndex += 1) {
        const { sourceIndex, flipped } = clonePosition(cloneIndex, sources.length);
        const source = sources[sourceIndex];

        if (!source) {
          break;
        }

        const clone = document.createElement('img');
        clone.src = source.currentSrc || source.src;
        clone.srcset = source.srcset;
        clone.sizes = source.sizes;
        clone.width = source.width;
        clone.height = source.height;
        clone.alt = '';
        clone.draggable = false;
        clone.loading = 'lazy';
        clone.decoding = 'async';
        clone.dataset.repeat = '';

        if (flipped) {
          clone.style.transform = 'scaleY(-1)';
        }

        stack.append(clone);
      }
    }
  }

  if (!customElements.get('uruk-texture-field')) {
    customElements.define('uruk-texture-field', UrukTextureField);
  }
</script>

<style>
  uruk-texture-field {
    /* Matches the texture's average tone, so the page doesn't change colour while the images load. */
    background: #e2e0db;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
    z-index: 0;
  }

  .texture-field__stack {
    display: flex;
    flex-direction: column;
    left: 50%;
    position: absolute;
    top: 0;
    transform: translateX(-50%);
  }

  .texture-field__stack img {
    display: block;
    flex: none;
    height: auto;
    width: 100%;
  }

  .texture-field__stack--desktop {
    width: max(90rem, 100vw);
  }

  .texture-field__stack--phone {
    display: none;
    width: max(24.375rem, 100vw);
  }

  @media (max-width: 47.999rem) {
    .texture-field__stack--desktop {
      display: none;
    }

    .texture-field__stack--phone {
      display: flex;
    }
  }
</style>
