---
import rosetteUrl from '../../assets/rosette/loftus-64.png?url';
import logoUrl from '../../assets/logo/footer.svg?url';
import BackToTop from '../back-to-top/BackToTop.astro';
import SupportLinks from '../support-links/SupportLinks.astro';
import { ROSETTE_CREDIT, SEAL_CREDIT, TEXTURE_CREDIT, TYPE_CREDIT, type Credit } from './credits';

interface Props {
  credits?: Credit[];
}

const DEFAULT_CREDITS: Credit[] = [
  SEAL_CREDIT,
  ROSETTE_CREDIT,
  TEXTURE_CREDIT,
  TYPE_CREDIT,
];

const { credits = DEFAULT_CREDITS } = Astro.props;
---

<footer class="site-footer" data-page-footer>
  <div class="site-footer__ornament">
    <span class="site-footer__rule"></span>
    <img draggable="false" src={rosetteUrl} alt="" width="64" height="64" />
    <span class="site-footer__rule"></span>
  </div>
  <nav class="site-footer__links" aria-label="Footer">
    <a class="case-link" href="/results/">All results</a>
    <span aria-hidden="true">·</span>
    <a class="case-link" href="/how-we-check/">How we check</a>
    <span aria-hidden="true">·</span>
    <a class="case-link" href="/about/">About</a>
  </nav>
  <div class="site-footer__support">
    <SupportLinks />
  </div>
  <div class="site-footer__credits">
    {credits.map((credit) => (
      <div class="site-footer__credit">
        <p class="site-footer__credit-label">{credit.label}</p>
        {credit.label === 'Type' ? (
          <p>
            <span>Set in Alegreya, Special Elite</span>{' '}
            <span class="site-footer__type-second">and Garamond-Math.</span>
          </p>
        ) : (
          <p>{credit.text}</p>
        )}
      </div>
    ))}
  </div>
  <div class="site-footer__bottom">
    <img draggable="false" src={logoUrl} alt="" width="104" height="35" />
    <BackToTop />
  </div>
</footer>

<style>
  .site-footer {
    align-items: center;
    display: flex;
    flex-direction: column;
    padding: 56px var(--page-gutter) 64px;
    position: relative;
    z-index: 2;
  }

  .site-footer__ornament {
    align-items: center;
    display: flex;
    gap: 18px;
    height: 64px;
    max-width: 1220px;
    width: 100%;
  }

  .site-footer__rule {
    background: var(--ink);
    flex: 1 1 0;
    height: 1px;
    min-width: 0;
  }

  .site-footer__ornament img {
    display: block;
    flex: none;
    height: 64px;
    width: 64px;
  }

  .site-footer__links {
    align-items: center;
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 36px;
  }

  .site-footer__links a {
    color: var(--ink);
    font-family: var(--font-alegreya);
    font-size: 1.375rem;
    font-style: italic;
    line-height: 1.8125rem;
    text-decoration: none;
  }

  .site-footer__links span {
    color: var(--muted);
    font-family: var(--font-alegreya);
    font-size: 1.375rem;
    font-style: italic;
    line-height: 1.8125rem;
  }

  .site-footer__support {
    margin-top: 20px;
  }

  /* Credits share one row while each column keeps at least 180 px; a longer list wraps, centred, onto a second row. */
  .site-footer__credits {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 48px;
    justify-content: center;
    margin-top: 44px;
    max-width: 1168px;
    width: 100%;
  }

  .site-footer__credit {
    align-items: center;
    display: flex;
    flex: 1 1 180px;
    flex-direction: column;
    gap: 8px;
    max-width: 256px;
    text-align: center;
  }

  .site-footer__credit-label {
    color: var(--muted);
    font-family: var(--font-special-elite);
    font-size: var(--label-font-size);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.125rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Set at the body text's smallest size, so the credits read as easily as the page above them. */
  .site-footer__credit p:not(.site-footer__credit-label) {
    color: var(--ink);
    font-family: var(--font-alegreya);
    font-size: 1.0625rem;
    font-style: italic;
    line-height: 1.625rem;
    max-width: 256px;
  }

  /* On a tablet the credits pair up in two columns rather than squeezing four or five across. */
  @media (min-width: 48rem) and (max-width: 63.999rem) {
    .site-footer__credit {
      flex: 0 0 calc(50% - 24px);
      max-width: none;
    }
  }

  /* Kept whole, so a narrow phone never splits Garamond-Math at its hyphen. */
  .site-footer__type-second {
    display: block;
    white-space: nowrap;
  }

  .site-footer__bottom {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin-top: 56px;
    max-width: 1328px;
    width: 100%;
  }

  .site-footer__bottom > img {
    display: block;
    flex: none;
    height: auto;
    width: 104px;
  }

  @media (max-width: 47.999rem) {
    .site-footer {
      padding-block: 40px;
    }

    .site-footer__ornament {
      height: 48px;
    }

    .site-footer__ornament img {
      height: 48px;
      width: 48px;
    }

    .site-footer__links {
      gap: 14px;
      margin-top: 28px;
    }

    .site-footer__credits {
      align-items: center;
      flex-direction: column;
      gap: 24px;
      margin-top: 32px;
    }

    .site-footer__credit {
      flex-basis: auto;
      max-width: none;
      width: 100%;
    }

    .site-footer__credit p:not(.site-footer__credit-label) {
      max-width: none;
    }

    .site-footer__type-second {
      display: inline;
    }

    .site-footer__bottom {
      margin-top: 40px;
    }
  }
</style>
