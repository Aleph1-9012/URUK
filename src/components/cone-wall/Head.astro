---
import atlas from './data/heads.webp?url';
import workerUrl from './opening-worker?worker&url';
import headUrl from './head.js?url&no-inline';
import { coneArrivalScripts } from './arrival-assets';
import { startConeArrival } from './arrival-bootstrap';
import { conePacks } from './arrival-packs';
import { getConeData } from './asset-build';

const { manifest } = await getConeData();
const assets = JSON.stringify({ ...manifest, head: headUrl });
const boot = `(${startConeArrival.toString()})(${conePacks.toString()},${coneArrivalScripts.toString()});`;
---
<style is:inline>
  /* The native scroll thumb otherwise paints over the closed wall in Gecko. */
  :root:is([data-cone-loading], [data-cone-stage]) { scrollbar-color: transparent transparent; }
  /* The head canvas covers the body until the first release frame. */
  @supports (-moz-appearance: none) {
    :root[data-cone-stage="arriving"]:not([data-cone-layout-ready]) > body {
      content-visibility: hidden;
      contain-intrinsic-size: auto 100vh;
    }
  }
  /* Some WebKit scroll thumbs are drawn above fixed content. Keep classic gutters in place. */
  :root[data-cone-overlay-scrollbar]:is([data-cone-loading], [data-cone-stage]) { scrollbar-width: none; }
  .cone-wall { display: none; }
  :root:is([data-cone-stage="pressing"], [data-cone-stage="covered"]) .cone-wall,
  #cone-head-face {
    display: block;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    position: fixed;
    z-index: 100;
  }
  #cone-head-face, .cone-wall > canvas { height: 100%; width: 100%; }
  .cone-wall > canvas { inset: 0; pointer-events: none; position: absolute; }
</style>
<script is:inline id="cone-config" data-atlas={atlas} data-worker={workerUrl} data-cone-assets={assets} set:html={boot}></script>
