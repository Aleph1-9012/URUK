---
import Base from './Base.astro';
import CountTransitionCover from '../components/count-transition/Cover.astro';
import CountTransitionHead from '../components/count-transition/Head.astro';
import Footer from '../components/footer/Footer.astro';
import Header from '../components/header/Header.astro';
import TextureField from '../components/texture-field/TextureField.astro';

interface Props {
  title: string;
  math?: boolean;
  active: 'results' | 'how-we-check' | 'about' | 'none';
  showFooter?: boolean;
  showFooterOnPhone?: boolean;
  showSearch?: boolean;
}

const {
  title,
  math = false,
  active,
  showFooter = true,
  showFooterOnPhone = true,
  showSearch = false,
} = Astro.props;
const PageTag = showSearch ? 'uruk-menu' : 'div';
---

<Base title={title} math={math}>
  <Fragment slot="head">{active === 'results' && <CountTransitionHead />}</Fragment>
  {active === 'results' && <CountTransitionCover />}
  <PageTag class="page-layout" id="top">
    <TextureField />
    <Header active={active} showSearch={showSearch}><slot name="search" slot="search" /></Header>
    <main class="page-layout__main">
      <slot />
    </main>
    {showFooter && <Footer hideOnPhone={!showFooterOnPhone} />}
  </PageTag>
</Base>

<style>
  .page-layout {
    min-height: 100svh;
    overflow-x: clip;
    position: relative;
  }

  .page-layout__main {
    min-width: 0;
    position: relative;
  }
</style>
