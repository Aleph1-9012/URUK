---
import PageLayout from '../../layouts/PageLayout.astro';
import Roll from '../../components/roll/Roll.astro';
import Icon from '../../components/icon/Icon.astro';
import StatusSign from '../../components/status-sign/StatusSign.astro';
import { SEAL_CREDIT } from '../../components/footer/credits';
import { visibleResults } from '../../content/results';
import { reviewStatuses, statusKind } from '../../content/review-status';
import '../../components/menu/menu.css';

const results = await visibleResults();
---

  <PageLayout title="All results · Uruk" active="results" showSearch showFooterOnPhone={false}>
    <div class="menu-search case-link case-link--framed" slot="search" data-script-only>
      <span class="menu-icon menu-icon--search"><Icon name="search" /></span>
      <input type="search" aria-label="Search by paper title, topic or result number" placeholder="Search papers" data-search data-scroller autocomplete="off" />
      <button type="button" aria-label="Clear search" data-clear hidden><span class="menu-icon"><Icon name="clear" /></span></button>
    </div>
    <div class="menu-page">
      <h1 class="visually-hidden">All results</h1>
      <Roll results={results}>
        <div class="menu-filters" slot="controls" data-script-only role="group" aria-label="Filter by review status">
          <span>Show</span>
          <button class="case-link" type="button" data-filter="" aria-pressed="true"><span>All</span></button>
          {reviewStatuses.map(({ kind, label }) => (
            <button
              class="case-link"
              type="button"
              data-filter={kind}
              aria-pressed="false"
              disabled={!results.some(({ data }) => data.status === label)}
            >
              <StatusSign kind={kind} /><span>{label}</span>
            </button>
          ))}
        </div>
      </Roll>
      <p class="visually-hidden" role="status" aria-live="polite" data-result-count></p>
      <section class="menu-empty" data-no-results hidden>
        <h2 data-result-count>No matching results</h2>
        <p>Try another search or review status. To see all {results.length} results, clear the search and choose All.</p>
      </section>
      <section class="menu-index" data-result-index aria-labelledby="results-index-title">
        <h2 id="results-index-title" data-result-count>All {results.length} {results.length === 1 ? 'result' : 'results'}</h2>
        {results.map(({ data }) => (
          <a class="menu-index__row case-link case-link--row" data-index-family={data.family} href={`/results/${data.family}/`}>
            <span class="menu-index__label">
              <span class="menu-index__number">{data.family}</span>
              <span class="menu-index__title" data-highlight>{data.paperTitle}</span>
              <span class="menu-index__leader"></span>
            </span>
            <span class="menu-index__status"><StatusSign kind={statusKind(data.status)} />{data.status}</span>
            <span class="menu-index__read">Read <span class="menu-icon"><Icon name="right" /></span></span>
          </a>
        ))}
      </section>
      <p class="menu-phone-credit" data-roll-footnote>Seal impression along the roll: {SEAL_CREDIT.text}</p>
    </div>
  </PageLayout>

<script>
  import '../../components/menu/element';
</script>
