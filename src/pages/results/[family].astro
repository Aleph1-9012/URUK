---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/result/Section.astro';
import Roll from '../../components/roll/Roll.astro';
import Sources from '../../components/sources/Sources.astro';
import StatusSign from '../../components/status-sign/StatusSign.astro';
import ResultVisual from '../../components/visuals/ResultVisual.astro';
import ornament from '../../assets/ornaments/ornament.svg?url';
import { checkedDate, paperBase, statusKind, visibleResults } from '../../content/results';
import { renderResult } from '../../content/render';
import '../../components/result/result.css';
import '../../styles/formula.css';

export const getStaticPaths = (async () => {
  const results = await visibleResults();

  return results.map((entry) => ({ params: { family: entry.data.family }, props: { entry, results } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, results } = Astro.props;
const { data } = entry;

if (!entry.body) {
  throw new Error(`Result ${data.family} has no text.`);
}

const content = renderResult(entry.body, data.link);
---

<PageLayout title={`${data.family} · ${data.topic} · Uruk`} active="results">
  <article class="folio-page result-page">
    <a class="result-breadcrumb case-link" href="/results/">All results / {data.family}</a>
    <div class="result-opening">
      {data.visual ? (
        <ResultVisual visual={data.visual} />
      ) : (
        <figure class="result-plate-one">
          <div class="result-visual"><span>No visual yet.</span></div>
          <figcaption>Plate I. An interactive visual for this result will appear here.</figcaption>
        </figure>
      )}
      <div class="result-introduction">
        <p class="result-label">{data.family} · {data.topic}</p>
        <h1>{data.title}</h1>
        <img draggable="false" class="result-ornament" src={ornament} alt="" width="640" height="12" />
        <p class="folio-top__copy">{data.claim}</p>
        <p class="result-status"><StatusSign kind={statusKind(data.status)} /><span>{data.status}</span></p>
        <p class="result-checked">Checked {checkedDate(data.checked)}. <a class="text-link" href="/how-we-check/">What this label means</a>.</p>
        <nav class="result-contents" aria-label="On this page">
          <p class="folio-contents__title">Contents</p>
          {content.sections.map(({ numeral, id, title }) => <a class="folio-contents__row case-link case-link--row" href={`#${id}`}><span class="folio-contents__number">{numeral}.</span><span class="folio-contents__text">{title}</span><span class="folio-contents__leader"></span></a>)}
        </nav>
      </div>
    </div>

    <div class="folio-row result-standfirst">
      <div class="folio-row__text result-prose" set:html={content.introduction} />
    </div>

    {content.sections.map((section) => (
      <Section id={section.id} numeral={section.numeral} title={section.title}>
        {section.key === 'sources' ? (
          <>
            <div class="folio-row"><div class="folio-row__text"><p class="result-paper-links">{data.papers.map((path, index) => <a class="text-link" href={`${paperBase}${path}`}>{index === 0 ? 'Read the paper' : `Companion paper ${index}`}</a>)}</p></div></div>
            <div class="folio-row"><Sources sources={content.sources} /></div>
          </>
        ) : (
          <div class="folio-row">
            {section.key === 'review' && <p class="folio-row__margin result-margin">{checkedDate(data.checked)}</p>}
            <div class="folio-row__text">
              {section.key === 'review' && <p class="result-status"><StatusSign kind={statusKind(data.status)} /><span>{data.status}</span></p>}
              <div class:list={['result-prose', { 'result-theorem': section.key === 'claim' }]} set:html={section.html} />
            </div>
          </div>
        )}
      </Section>
    ))}
  </article>
  <nav class="result-on-roll" aria-label="Previous and next results"><h2>On the roll</h2><Roll results={results} current={data.family} /></nav>
</PageLayout>

<script>
  import '../../components/formula/element';
</script>
